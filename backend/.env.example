# 이 파일을 backend/.env로 복사해서 실제 값을 채워 넣으세요.
# 로컬 개발용 기본값(코드에 하드코딩된 것)은 대부분 localhost:8000/5173이라, 아래 값들을
# 안 채워도 로컬에서는 그냥 동작합니다. 실제 서버에 배포할 때만 채우면 됩니다 — 자세한 절차는
# README.md의 "배포" 절 참고.

# ── 필수 ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# 임의의 긴 무작위 문자열. 예: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── LLM 백엔드 선택 ────────────────────────────────────────────────────
# openai(기본값) 또는 ollama. 기업 보안 정책상 문서 내용을 외부 API로 보낼 수 없다면
# ollama로 바꾸고, 회사 내부망(또는 로컬)에 Ollama 서버를 띄운 뒤 아래 값들을 채우세요.
# 위 OPENAI_API_KEY는 ollama 백엔드에서는 필요 없습니다. 자세한 내용은 backend/llm_backend.py
# 상단 docstring 참고.
LLM_BACKEND=openai
# Ollama 서버 주소. 기본값: http://localhost:11434
OLLAMA_BASE_URL=
# 요약/채팅용, 임베딩용 모델 이름. 기본값: llama3.1 / nomic-embed-text
# (둘 다 미리 "ollama pull <모델명>"으로 받아둬야 합니다)
OLLAMA_CHAT_MODEL=
OLLAMA_EMBED_MODEL=

# ── 배포 시에만 채우면 됨 (안 채우면 아래 기본값으로 동작) ──────────────
# 배포한 프론트엔드 주소. 콤마로 여러 개 가능. 기본값: http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGINS=
# 회원가입을 특정 이메일 도메인으로 제한(콤마로 여러 개). 비워두면(기본값) 아무나 가입 가능.
# 포트폴리오/데모처럼 누구나 가입 가능해야 하면 비워두되, DAILY_SEARCH_LIMIT은 꼭 설정할 것.
SIGNUP_ALLOWED_DOMAINS=
# 계정당 하루 검색+문서 재요약(둘 다 OpenAI 비용 발생) 한도. 기본값 50 — 도메인 제한 없이
# 공개 배포할 때 낯선 방문자가 검색을 반복해서 크레딧을 소진시키는 걸 막기 위함.
DAILY_SEARCH_LIMIT=

# ── Google Drive 연동 (OAuth) ────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 기본값: http://localhost:8000/api/v1/auth/link/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Google 로그인(이메일+비밀번호 대신 Google 계정으로 로그인/가입) — 위 CLIENT_ID/SECRET을
# 그대로 재사용하되, Google Cloud Console의 같은 OAuth 클라이언트에 아래 URI도 "승인된
# 리디렉션 URI"로 추가 등록해야 한다(기존 .../link/google/callback과 공존 가능).
# 기본값: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=

# ── 카카오 로그인 (이메일+비밀번호 대신 카카오 계정으로 로그인/가입) ──────
# developers.kakao.com → 앱 생성 → 카카오 로그인 활성화 → 앱 키의 "REST API 키"가 CLIENT_ID.
# CLIENT_SECRET은 보안 메뉴에서 선택 활성화(활성화했으면 필수로 같이 보내야 함).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔의 "카카오 로그인 → Redirect URI"에 이 값을 그대로 등록해야 한다.
# 기본값: http://localhost:8000/api/v1/auth/kakao/callback
KAKAO_LOGIN_REDIRECT_URI=

# ── GitHub 연동 (OAuth) ──────────────────────────────────────────────
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 기본값: http://localhost:8000/api/v1/auth/link/github/callback
GITHUB_OAUTH_REDIRECT_URI=

# ── GitLab 연동 (OAuth) ──────────────────────────────────────────────
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# 기본값: http://localhost:8000/api/v1/auth/link/gitlab/callback
GITLAB_OAUTH_REDIRECT_URI=
# 자체 호스팅 GitLab을 쓰는 경우에만 설정. 기본값: https://gitlab.com
GITLAB_URL=

# ── Slack 연동 (OAuth) ───────────────────────────────────────────────
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
# Slack은 redirect URL로 "localhost"를 거부하고 "127.0.0.1"만 허용한다(로컬 개발 시 주의).
# 기본값: http://localhost:8000/api/v1/auth/link/slack/callback
SLACK_OAUTH_REDIRECT_URI=

# ── Notion 연동 (OAuth) ──────────────────────────────────────────────
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# 기본값: http://localhost:8000/api/v1/auth/link/notion/callback
NOTION_OAUTH_REDIRECT_URI=

# ── 레거시: 관리자가 미리 지정한 고정 목록으로 수집하던 초기 방식의 흔적 ──
# 지금은 "계정 연동 = 그 사람이 실제 접근 가능한 문서 전체 자동 수집"으로 바뀌어서(위 OAuth
# 연동이 표준 경로) 아래 값들은 더 이상 필요하지 않습니다. 남겨진 스크립트를 쓸 게 아니면
# 비워둬도 됩니다.
NOTION_TOKEN=
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
GITHUB_REPOS=
GITLAB_TOKEN=
GITLAB_PROJECTS=
